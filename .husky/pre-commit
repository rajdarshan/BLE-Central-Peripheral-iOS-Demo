echo "🔍 Checking Swift styling guidelines..."

# Use -z / -0 so filenames with spaces or special characters survive the pipe intact
STAGED_SWIFT_FILES=$(git diff --diff-filter=d --cached --name-only -z -- '*.swift')

if [ -z "$STAGED_SWIFT_FILES" ]; then
  echo "✅ No Swift files staged. Skipping SwiftLint."
  exit 0
fi

echo "Running validation on staged files..."

# Neutralize errexit just for this line, so a SwiftLint failure doesn't kill
# the script before we get a chance to capture/print its output.
set +e
OUTPUT=$(printf '%s' "$STAGED_SWIFT_FILES" | xargs -0 swiftlint lint --strict 2>&1)
RESULT=$?
set -e

echo "$OUTPUT"

if [ $RESULT -ne 0 ]; then
  echo "❌ Commit aborted: SwiftLint failed or found styling violations."
  exit 1
else
  echo "✅ SwiftLint passed. Proceeding with commit."
  exit 0
fi